{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "dialog:allow-save",
    "fs:default",
    {
      "identifier": "fs:allow-app-local-data-read",
      "allow": [{ "path": "$APP_LOCAL_DATA/**" }, { "path": "$APP_DATA/**" }]
    }
  ]
}
