{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WatchMark Media Tracker",
  "version": "1.2.0",
  "identifier": "com.jules.watchmark-tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "cli": {
      "watch": {
        "ignore": [
          "**/WatchMark/**",
          "WatchMark/**",
          "WatchMark/*",
          ".taurignore"
        ]
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "WatchMark",
        "width": 800,
        "height": 600,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": true,
        "backgroundColor": "#0D0F14"
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: http://asset.localhost https://asset.localhost localhost:* http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https://asset.localhost https: http: data: blob: localhost:* http://127.0.0.1:*; font-src 'self' asset: http://asset.localhost https://asset.localhost data:; media-src 'self' asset: http://asset.localhost https://asset.localhost watchmark: blob: data: http: https:;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**",
          "$APP_LOCAL_DATA/**",
          "$APPDATA/**",
          "C:\\Users\\**",
          "C:/**",
          "D:/**",
          "E:/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "copyright": "© 2026 WatchMark",
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
