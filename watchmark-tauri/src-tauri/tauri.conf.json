{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WatchMark Media Tracker",
  "version": "1.2.0",
  "identifier": "com.jules.watchmark-tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "cli": {
      "watch": {
        "ignore": [
          "**/WatchMark/**",
          "WatchMark/**",
          "WatchMark/*",
          ".taurignore"
        ]
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "WatchMark",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "copyright": "© 2026 WatchMark",
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
