{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "watchmark-tauri",
  "version": "0.1.0",
  "identifier": "com.jules.watchmark-tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "cli": {
      "watch": {
        "ignore": [
          "**/WatchMark/**",
          "WatchMark/**",
          "WatchMark/*",
          ".taurignore"
        ]
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "watchmark-tauri",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
